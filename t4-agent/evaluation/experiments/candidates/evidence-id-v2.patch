+def test_prompt_local_evidence_id_restores_exact_source_span() -> None:
+    text = "Management raised full-year revenue guidance."
+    corpus = IndexedCorpus([], {"A": text}, {"A": "2023-01-01"})
+    parsed = {
+        "signals": {
+            "yoy_earnings_signal": {
+                "level": 2,
+                "evidence_id": "E1",
+                "claim": "Management raised guidance.",
+            }
+        }
+    }
+    refs = {"E1": {"doc_id": "A", "span_start": 0, "span_end": len(text), "quote": text}}
+
+    signals, _, facts, rejected = validate_model_output(
+        parsed, SPECS["eps_yoy"], "ENTITY", corpus, {"A"}, refs
+    )
+
+    assert signals["yoy_earnings_signal"] == 2
+    assert not rejected
+    assert facts[0].extractor == "model_evidence_id"
+    assert facts[0].quote == text
+    assert (facts[0].span_start, facts[0].span_end) == (0, len(text))
+
+
+@pytest.mark.parametrize(
+    ("evidence_id", "refs", "reason"),
+    [
+        ("E9", {"E1": {"doc_id": "A", "span_start": 0, "span_end": 8, "quote": "evidence"}}, "evidence_id_not_in_entity_scope"),
+        ("E1", {"E1": {"doc_id": "B", "span_start": 0, "span_end": 8, "quote": "evidence"}}, "doc_not_in_entity_scope"),
+        ("E1", {"E1": {"doc_id": "A", "span_start": 1, "span_end": 9, "quote": "evidence"}}, "evidence_id_span_mismatch"),
+    ],
+)
+def test_prompt_local_evidence_id_fails_closed(evidence_id, refs, reason) -> None:
+    corpus = IndexedCorpus([], {"A": "evidence"}, {"A": "2023-01-01"})
+    parsed = {
+        "signals": {
+            "yoy_earnings_signal": {
+                "level": 2,
+                "evidence_id": evidence_id,
+                "claim": "Guidance improved.",
+            }
+        }
+    }
+
+    signals, _, facts, rejected = validate_model_output(
+        parsed, SPECS["eps_yoy"], "ENTITY", corpus, {"A"}, refs
+    )
+
+    assert signals["yoy_earnings_signal"] == 0
+    assert not facts
+    assert rejected[0].reason == reason
+
+
+def test_evidence_id_prompt_omits_copyable_doc_and_span_fields(monkeypatch) -> None:
+    text = "Management raised full-year revenue guidance."
+    chunk = Chunk("A", "2023-01-01", 0, len(text), text)
+    corpus = IndexedCorpus([chunk], {"A": text}, {"A": "2023-01-01"})
+    task = make_task("eps_yoy_direction", "eps_yoy_direction", [{"entity_id": "ENTITY"}])
+    monkeypatch.setenv("T4_EVIDENCE_IDS", "1")
+
+    class FakeLLM:
+        prompt = ""
+
+        def chat_json(self, system: str, user: str, max_tokens: int) -> dict:
+            self.prompt = user
+            return {
+                "context": {"evidence_id": "E1", "claim": "Management discussed guidance."},
+                "signals": {"yoy_earnings_signal": {"level": 0}},
+            }
+
+    llm = FakeLLM()
+    results = predict_rows(task, BM25([chunk]), corpus, llm, top_k=1)
+
+    evidence_json = llm.prompt.split("EVIDENCE_JSON:\n", 1)[1].split("\nOUTPUT_SCHEMA_JSON:", 1)[0]
+    evidence = json.loads(evidence_json)
+    assert evidence == [{"evidence_id": "E1", "doc_date": "2023-01-01", "text": text}]
+    assert results[0].facts[-1].quote == text
+
+
 def test_exact_quote_produces_a_span_bound_fact() -> None:
     text = "prefix explicit guidance improved suffix"
